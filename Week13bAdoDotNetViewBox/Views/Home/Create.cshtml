@model Week13bAdoDotNetViewBox.Models.Employee
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Create</h2>

@ViewBag.Shiv

@using (Html.BeginForm("Create", "Home", FormMethod.Post))
{
    @Html.HiddenFor(a => a.id)

    <label>FirstName</label>
    @Html.TextBoxFor(model => model.FirstName)
    <br />
    <br />

    <label>LastName</label>
    @Html.TextBoxFor(model => model.LastName)
    <br />
    <br />
    <label>Email</label>
    @Html.TextBoxFor(model => model.Email)
    <br />
    <br />



    <div>
        @Html.Label("Gender")
        @Html.RadioButtonFor(m => m.Gender, "Male") Male
        @Html.RadioButtonFor(m => m.Gender, "Female") Female
    </div>

    <button type="submit" class=" btn btn-warning">Save</button>
}

<br />

<h6>View Data</h6>
<table class="table">
    <thead>
        <tr>

            <th>FirstName</th>
            <th>LastName</th>
            <th>Email</th>
            <th>gender</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@ViewBag.Message1</td>
            <td>@ViewBag.Message2</td>
            <td>@ViewBag.Message3</td>
            <td>@ViewBag.Message4</td>
            
        </tr>

    </tbody>
</table>



<h6>Temp Data</h6>
<table class="table">
    <thead>
        <tr>

            <th>FirstName</th>
            <th>LastName</th>
            <th>Email</th>
            <th>gender</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@TempData["Message1"]</td>
            <td>@TempData["Message2"]</td>
            <td>@TempData["Message3"]</td>
            <td>@TempData["Message4"]</td>
        </tr>

    </tbody>
</table>